[Unit]
Description=Infoborden signage server
Documentation=file:///opt/infoborden/docs/install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=infoborden
Group=infoborden

# The standalone bundle expects to run from its own directory.
WorkingDirectory=/opt/infoborden/.next/standalone
EnvironmentFile=/opt/infoborden/.env.local

Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=80

# Bind port 80 without running as root, so the screens can use a bare URL.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/infoborden

ExecStart=/usr/bin/node server.js

# A signage box should heal itself; nobody is watching it.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
