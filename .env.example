# Leave SHEET_ID empty to run the board on demo data.
SHEET_ID=
SHEET_RANGE=Vervangingen!A1:H400
KEYS_SHEET_RANGE=Sleutels!A1:H200
EVENTS_SHEET_RANGE=Evenementen!A1:H100
MESSAGES_SHEET_RANGE=Mededelingen!A1:K200
BIRTHDAYS_SHEET_RANGE=Verjaardagen!A1:F1000
SETTINGS_SHEET_RANGE=Settings!A1:L30
SCHEDULE_SHEET_RANGE=Schedule!A1:E50
PIKET_SHEET_RANGE=Piket!A1:H60
STYLE_SHEET_RANGE=Style!A1:C40
SPECIAL_OCCASIONS_RANGE=Speciale Gelegenheden!A1:M400


TIMEZONE=Europe/Brussels
LOCALE=nl-BE

# The build stamp in the corner of each screen: which build the panel is running.
# Unset means on in development, off in production — a normal school day doesn't
# need a commit hash on the wall. Set `on` while troubleshooting a deploy; the
# screens pick that up within 30 seconds, and `?build=1` / `?build=0` on a screen
# URL overrides it for one screen. Screens reload themselves onto a new deploy
# either way.
# BUILD_STAMP=on

# How much pupil data this deployment shows: `full` (default, as the corridor
# board has always run) or `reduced`. Reduced empties pupil names out of the
# payload server-side — birthdays become a count plus their classes, key duties
# name only the class — and drops notices ticked "Enkel op bord".
#
# It describes the audience the whole instance serves, so it can't be set per
# request: no URL talks a reduced deployment into handing the names over. It is
# also independent of *where* the instance runs — a school with no corridor
# screens, read only from home by its own staff, may well want `full`.
#
# On a deployment published outside the school, prefer narrowing the ranges as
# well, so the names are never fetched at all. See docs/deploy-cloud.md:
#   PUPIL_DATA=reduced
#   BIRTHDAYS_SHEET_RANGE=Verjaardagen!C1:F1000
# PUPIL_DATA=full

# Appearance — Steinerschool Gent style guide.
# THEME: light | dark        ACCENT: coral | gold | blue
# Both can be overridden per screen with ?theme= / ?accent= on the board URL.
THEME=light
ACCENT=coral

# Path to the service-account key. A relative path works in local dev; on a
# deployed server use an absolute path (the service runs from .next/standalone)
# — see docs/install.md.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
