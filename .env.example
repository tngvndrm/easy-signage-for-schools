# Leave SHEET_ID empty to run the board on demo data.
SHEET_ID=
SHEET_RANGE=Vervangingen!A1:F400

# Divider row is drawn after this lesson period.
BREAK_AFTER_PERIOD=4

TIMEZONE=Europe/Brussels
LOCALE=nl-BE

# Appearance — Steinerschool Gent style guide.
# THEME: light | dark        ACCENT: coral | gold | blue
# Both can be overridden per screen with ?theme= / ?accent= on the board URL.
THEME=light
ACCENT=coral

# Local dev only — on Cloud Run, attach the service account to the revision.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
